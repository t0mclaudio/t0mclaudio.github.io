---
import { AUTHOR } from '../consts';
---

<aside class="author-sidebar">
  <a href="/" class="author-sidebar__avatar">
    <img src={AUTHOR.avatar} alt={AUTHOR.name} />
  </a>
  <p class="author-sidebar__name"><a href="/"><strong>{AUTHOR.name}</strong></a></p>
  <p class="author-sidebar__bio">{AUTHOR.bio}</p>
  <ul class="author-sidebar__links">
    <li><a href={AUTHOR.github}>GitHub</a></li>
    <li><a href={`mailto:${AUTHOR.email}`}>Email</a></li>
    <li><a href={AUTHOR.linkedin}>LinkedIn</a></li>
  </ul>
</aside>
