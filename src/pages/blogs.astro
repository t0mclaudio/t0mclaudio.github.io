---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthorSidebar from '../components/AuthorSidebar.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="Blogs">
  <div class="page-layout">
    <AuthorSidebar />
    <main class="page-content">
      <h1>Blogs</h1>
      <ul class="post-list">
        {
          posts.map((post) => (
            <li class="post-list__item">
              <a href={`/blogs/${post.id}/`} class="post-list__thumb-link">
                {post.data.heroImageThumb && (
                  <img
                    class="post-list__thumb"
                    src={post.data.heroImageThumb}
                    alt={post.data.title}
                    width="640"
                    height="335"
                    loading="lazy"
                  />
                )}
              </a>
              <div class="post-list__body">
                <a class="post-list__title" href={`/blogs/${post.id}/`}>
                  {post.data.title}
                </a>
                <p class="post-meta">
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </p>
                <p>{post.data.description}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </main>
  </div>
</BaseLayout>
